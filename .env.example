# =============================================================================
# RepairConnect AI — environment variables (PLACEHOLDERS ONLY — safe to commit)
# -----------------------------------------------------------------------------
# This is the template for the central `.env` file (which is gitignored).
# Copy to `.env` and fill in real values locally. NEVER commit real values.
#
# Where each group is consumed:
#   • FIREBASE_* / JUDGE_DEMO_*  → PUBLIC config → js/firebase-config.js
#     (Firebase web config is NOT a server-side secret).
#   • OPENAI_* / GROQ_* / ANALYZE_* / BACKUP_*  → SERVER-SIDE ONLY →
#     Firebase Cloud Functions secrets/env (see functions/.env.example).
#   • Memcode  → NOT DEFINED YET. Add the exact official names only after
#     verifying the official Memcode documentation. No names are invented.
# =============================================================================

# ==========================================
# FIREBASE — PUBLIC WEB CONFIG (NOT a secret)
# ==========================================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ==========================================
# DEMO / JUDGE ACCOUNT (demo-only, NOT a production secret)
# ==========================================
JUDGE_DEMO_EMAIL=judge@repairconnect.ai
JUDGE_DEMO_PASSWORD=your_judge_demo_password_placeholder

# ==========================================
# PRIMARY AI — OPENAI (SERVER-SIDE ONLY)
# ==========================================
OPENAI_API_KEY=your_openai_api_key_placeholder

# Vision-capable model — VERIFY the currently-supported model before use
# (consumed by functions/lib/ai.js as OPENAI_VISION_MODEL).
OPENAI_VISION_MODEL=verified_model_name_placeholder

# Optional: override the OpenAI base URL (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==========================================
# BACKUP AI — GROQ (SERVER-SIDE ONLY)
# ==========================================
GROQ_API_KEY=your_groq_api_key_placeholder

# Vision-capable model — VERIFY the currently-supported model before use
# (consumed by functions/lib/ai.js as GROQ_VISION_MODEL).
GROQ_VISION_MODEL=verified_model_name_placeholder

# Optional: override the Groq base URL (default: https://api.groq.com/openai/v1)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ==========================================
# APPLICATION / BACKEND (SERVER-SIDE)
# ==========================================

# Per-user daily analysis limit (code default is 20 when unset).
ANALYZE_DAILY_LIMIT=20

# Enable Firebase Storage BACKUP copies of media (only after Memcode is live).
BACKUP_ENABLED=false

# ==========================================
# PRIMARY MEDIA STORAGE — MEMCODE (UNVERIFIED)
# ==========================================
# Do NOT invent Memcode variable names. After verifying the official Memcode
# documentation, add the EXACT official names here, for example:
#   MEMCODE_<EXACT_OFFICIAL_NAME>=your_placeholder_after_verifying_docs
# Memcode credentials (if any) must remain SERVER-SIDE only.
