rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // ---- users/{uid} : own document only; protected fields immutable ----
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.uid == request.auth.uid
                    && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if isOwner(uid)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false; // accounts are deleted via Firebase Auth, not Firestore
    }

    // ---- devices/{id} : ownership immutable ----
    match /devices/{id} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId)
                            && request.resource.data.userId == resource.data.userId;
    }

    // ---- diagnoses/{id} : created by the backend; owner-scoped reads ----
    match /diagnoses/{id} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);
    }

    // ---- mediaReferences/{id} ----
    match /mediaReferences/{id} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // ---- repairers/{id} : public business directory (read-only for clients) ----
    match /repairers/{id} {
      allow read: if signedIn();
      allow write: if false; // seeded/admin only
    }

    // ---- repairRequests/{id} ----
    // Clients may create a request (initial status "submitted") and read their
    // own. Status transitions + ownership are protected; further status changes
    // require the backend (later phase).
    match /repairRequests/{id} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId)
                    && request.resource.data.status == 'submitted';
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.status == resource.data.status
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(resource.data.userId);
    }

    // ---- repairStatusHistory/{id} : append-only, initial event only ----
    match /repairStatusHistory/{id} {
      allow read: if signedIn()
                  && get(/databases/$(database)/documents/repairRequests/$(resource.data.requestId)).data.userId == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.changedBy == 'user'
                    && request.resource.data.status == 'submitted'
                    && get(/databases/$(database)/documents/repairRequests/$(request.resource.data.requestId)).data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
