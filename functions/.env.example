# =============================================================================
# RepairConnect AI — Cloud Functions environment (PLACEHOLDERS ONLY)
# Copy to functions/.env for local emulation (gitignored). In production set
# these as Cloud Functions secrets / config. NEVER commit real values.
# (This file mirrors the SERVER-SIDE section of the central root `.env`.)
# =============================================================================

# --- PRIMARY AI: OpenAI (server-side only) ---
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_PLACEHOLDER
OPENAI_VISION_MODEL=VERIFY_AT_IMPLEMENTATION

# Optional: override the OpenAI base URL (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- BACKUP AI: Groq (failover only, server-side only) ---
GROQ_API_KEY=YOUR_GROQ_API_KEY_PLACEHOLDER
GROQ_VISION_MODEL=VERIFY_AT_IMPLEMENTATION

# Optional: override the Groq base URL (default: https://api.groq.com/openai/v1)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Optional: per-user daily analysis limit (default 20) ---
ANALYZE_DAILY_LIMIT=20

# =============================================================================
# STORAGE — PRIMARY: Memcode · BACKUP: Firebase Storage (roles are NOT reversed)
# =============================================================================

# Memcode is the PRIMARY media provider. Its integration is an adapter
# interface (functions/lib/storage.js) until the official Memcode
# documentation (endpoints, auth, credential names, limits) is verified.
# NO endpoint or credential name is assumed — add the exact official names
# here only after verifying the Memcode docs.
# MEMCODE_<EXACT_OFFICIAL_NAME>=YOUR_PLACEHOLDER_AFTER_VERIFYING_DOCS

# Backup: copy the file to Firebase Storage after a successful Memcode upload.
BACKUP_ENABLED=false
